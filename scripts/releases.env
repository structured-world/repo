# Releases the repository serves: the current and the previous release of each
# distribution. update-repos.sh publishes packages for these alone and removes
# what it holds for any other; build-docs.py lists only these on the site.
# Both read this file; the variables of the same name in the environment
# override it.
SERVED_DEB_DISTS="bookworm trixie noble resolute"
SERVED_RPM_RELEASES="44 45"
